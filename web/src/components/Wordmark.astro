---
/**
 * The tool's name, set rather than written.
 *
 * Two weights of one family with no space between them, and the accent carried
 * by a single dot. The compound reads as one word at a glance and resolves
 * into two on a second look, which is the whole idea of the name — and it
 * survives being 15px in a header and 40px in a hero, which a logotype with
 * any fine detail would not.
 */
interface Props {
  size?: string;
}
const { size = '1rem' } = Astro.props;
---

<span class="wordmark" style={`font-size:${size}`} aria-label="sectorradar">
  <span class="a">sector</span><span class="b">radar</span><span class="dot" aria-hidden="true"
  ></span>
</span>
