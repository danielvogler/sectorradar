# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env

# --- Crawler identity (required) -------------------------------------------
# A real contact address, published in the User-Agent of every request the
# crawler makes, so a site owner who objects can reach you. sectorradar
# REFUSES TO CRAWL if this is unset rather than sending an anonymous UA.
SECTORRADAR_CONTACT=you@example.com

# --- LLM provider (required for extract/classify) --------------------------
# Provider is one of: vertex | anthropic | openai
# vertex | anthropic | openai
#
# All three do structured output natively — Vertex with a response schema,
# Anthropic with a forced tool call, OpenAI with strict response_format — so
# the pipeline gets the same guarantee whichever you pick. Install the extra
# for the one you use: `uv sync --extra anthropic`.
SECTORRADAR_LLM_PROVIDER=vertex

# Vertex AI (default). Uses Application Default Credentials, so there is no key
# to paste here: run `gcloud auth application-default login` once.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
SECTORRADAR_LLM_MODEL=gemini-2.5-flash-lite

# Alternative providers. Leave blank unless SECTORRADAR_LLM_PROVIDER names them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Search provider (required for the websearch discovery source) ---------
# One of: vertex_grounding | exa | brave | tavily
# vertex_grounding reuses the Vertex credentials above and needs no key.
# vertex_grounding | anthropic | exa | brave | tavily
#
# The first two are models that search, so they need no separate search API
# key — the credential that runs extraction runs discovery. The others are
# search indexes and each needs its own key below.
SECTORRADAR_SEARCH_PROVIDER=vertex_grounding

# Model used for grounded search, when the provider is a model rather than an
# index. Leave blank to follow SECTORRADAR_LLM_MODEL. Worth setting: reading
# 24 pages of a website and running one search query are different jobs, and
# the cheap model that is fine for one is often wrong for the other.
SECTORRADAR_SEARCH_MODEL=
EXA_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=

# --- Local paths and logging ------------------------------------------------
SECTORRADAR_DB_PATH=data/radar.db
# One of: debug | info | warning | error
SECTORRADAR_LOG_LEVEL=info

# --- Sharing the result (optional) -------------------------------------------
#
# Set these and `make app` pulls the published dataset from Google Cloud
# Storage instead of exporting from a local database. That is the whole setup
# for somebody who wants to look at the data rather than collect it: no
# database, no API keys, no crawl.
#
# Authentication is Application Default Credentials — run
# `gcloud auth application-default login`. This tool never reads a downloaded
# service-account key, and you should never create one for it.
# Either this or GOOGLE_CLOUD_PROJECT above — this one wins if both are set.
# Leave it blank if you have already set GOOGLE_CLOUD_PROJECT.
SECTORRADAR_GCP_PROJECT=
SECTORRADAR_GCS_BUCKET=
SECTORRADAR_GCS_LOCATION=europe-west6
