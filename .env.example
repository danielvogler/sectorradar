# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env

# --- Crawler identity (required) -------------------------------------------
# A real contact address, published in the User-Agent of every request the
# crawler makes, so a site owner who objects can reach you. sectorradar
# REFUSES TO CRAWL if this is unset rather than sending an anonymous UA.
SECTORRADAR_CONTACT=you@example.com

# --- LLM provider (required for extract/classify) --------------------------
# Provider is one of: vertex | anthropic | openai
SECTORRADAR_LLM_PROVIDER=vertex

# Vertex AI (default). Uses Application Default Credentials, so there is no key
# to paste here: run `gcloud auth application-default login` once.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
SECTORRADAR_LLM_MODEL=gemini-2.5-flash-lite

# Alternative providers. Leave blank unless SECTORRADAR_LLM_PROVIDER names them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Search provider (required for the websearch discovery source) ---------
# One of: vertex_grounding | exa | brave | tavily
# vertex_grounding reuses the Vertex credentials above and needs no key.
SECTORRADAR_SEARCH_PROVIDER=vertex_grounding
EXA_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=

# --- Local paths and logging ------------------------------------------------
SECTORRADAR_DB_PATH=data/radar.db
# One of: debug | info | warning | error
SECTORRADAR_LOG_LEVEL=info
